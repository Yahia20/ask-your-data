# copy to .env and fill in. .env is gitignored.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Hard stop for this machine's cumulative LLM spend (USD), tracked in .cache/spend.json
MAX_SPEND_USD=0.75

# Leave unset to use the bundled demo warehouse (data/demo.duckdb).
# Point at a real Postgres with a READ-ONLY user to ask questions of live data:
# DATABASE_URL=postgresql://readonly_user:password@host:5432/railway

# The demo data ends on 2026-10-01, so "today" is pinned for it. Unset for live data.
TODAY=2026-10-02
TIMEZONE=Asia/Riyadh
